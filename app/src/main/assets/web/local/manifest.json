{
  "name": "OverDrive Dashboard",
  "short_name": "OverDrive",
  "description": "Vehicle dashboard, surveillance, and alerts for your BYD",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0E1311",
  "theme_color": "#00876C",
  "orientation": "any",
  "icons": [
    {
      "src": "/shared/app-icon-dark.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "/shared/app-icon-dark.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "/shared/app-icon.webp",
      "sizes": "432x432",
      "type": "image/webp",
      "purpose": "maskable"
    },
    {
      "src": "/shared/app-icon-ios.webp",
      "sizes": "180x180",
      "type": "image/webp",
      "purpose": "any"
    }
  ]
}
