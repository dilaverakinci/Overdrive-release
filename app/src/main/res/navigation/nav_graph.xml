<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.overdrive.app.ui.fragment.DashboardNativeFragment"
        android:label="@string/rail_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/genAiFragment"
        android:name="com.overdrive.app.ui.fragment.AssistantNativeFragment"
        android:label="@string/rail_assistant"
        tools:layout="@layout/fragment_assistant" />

    <!-- Live view: native -->
    <fragment
        android:id="@+id/liveViewFragment"
        android:name="com.overdrive.app.ui.fragment.LiveViewNativeFragment"
        android:label="@string/rail_live"
        tools:layout="@layout/fragment_live_view" />

    <!-- Recordings: native two-pane (library + player) -->
    <fragment
        android:id="@+id/recordingsFragment"
        android:name="com.overdrive.app.ui.fragment.RecordingsFragment"
        android:label="@string/rail_recordings"
        tools:layout="@layout/fragment_recordings" />

    <!-- Parking Intelligence: native -->
    <fragment
        android:id="@+id/parkingFragment"
        android:name="com.overdrive.app.ui.fragment.ParkingNativeFragment"
        android:label="@string/rail_parking"
        tools:layout="@layout/fragment_parking" />

    <!-- Surveillance settings (native) -->
    <fragment
        android:id="@+id/surveillanceSettingsWebFragment"
        android:name="com.overdrive.app.ui.fragment.settings.SettingsSurveillanceFragment"
        android:label="@string/settings_section_surveillance"
        tools:layout="@layout/fragment_settings_surveillance_native" />

    <!-- Recording settings (native) -->
    <fragment
        android:id="@+id/recordingSettingsWebFragment"
        android:name="com.overdrive.app.ui.fragment.settings.SettingsRecordingFragment"
        android:label="@string/settings_section_recording"
        tools:layout="@layout/fragment_settings_recording_native" />

    <!-- Vehicle: native vs legacy webview -->
    <fragment
        android:id="@+id/vehicleControlFragment"
        android:name="com.overdrive.app.ui.fragment.VehicleNativeFragment"
        android:label="@string/rail_vehicle"
        tools:layout="@layout/fragment_vehicle_native" />

    <!-- Projection (native only — cast + live mirror of the driver cluster) -->
    <fragment
        android:id="@+id/projectionFragment"
        android:name="com.overdrive.app.ui.fragment.ProjectionFragment"
        android:label="@string/rail_projection"
        tools:layout="@layout/fragment_projection" />

    <!-- Trips (Native) -->
    <fragment
        android:id="@+id/tripsFragment"
        android:name="com.overdrive.app.ui.fragment.TripsNativeFragment"
        android:label="@string/rail_trips"
        tools:layout="@layout/fragment_trips_native" />

    <!-- Charging (Native) -->
    <fragment
        android:id="@+id/chargingFragment"
        android:name="com.overdrive.app.ui.fragment.ChargingNativeFragment"
        android:label="@string/rail_charging"
        tools:layout="@layout/fragment_charging_native" />

    <!-- Automations (Native) -->
    <fragment
        android:id="@+id/automationsFragment"
        android:name="com.overdrive.app.ui.fragment.AutomationsNativeFragment"
        android:label="@string/rail_automations"
        tools:layout="@layout/fragment_automations_native" />

    <!-- Seat Positions (native) -->
    <fragment
        android:id="@+id/seatPositionsFragment"
        android:name="com.overdrive.app.ui.fragment.SeatPositionsNativeFragment"
        android:label="@string/rail_seat_positions"
        tools:layout="@layout/fragment_seat_positions_native" />

    <!-- Key Mapping (Native) -->
    <fragment
        android:id="@+id/keyMappingFragment"
        android:name="com.overdrive.app.ui.fragment.KeyMappingNativeFragment"
        android:label="@string/rail_key_mapping"
        tools:layout="@layout/fragment_key_mapping_native" />

    <!-- Integrations (Native) -->
    <fragment
        android:id="@+id/integrationsFragment"
        android:name="com.overdrive.app.ui.fragment.IntegrationsNativeFragment"
        android:label="@string/rail_integrations"
        tools:layout="@layout/fragment_integrations_native" />

    <!-- Sub-destinations under Integrations (entered via cards, not the rail).
         All three render via WebViewFragment pointing at the corresponding
         page in /web/local — keeps the integrations stack on a single
         renderer and lets us iterate on UX in HTML/CSS/JS instead of
         touching native layouts every time. -->
    <fragment
        android:id="@+id/telegramSettingsFragment"
        android:name="com.overdrive.app.ui.fragment.IntegrationsNativeFragment"
        android:label="@string/nav_page_telegram"
        tools:layout="@layout/fragment_integrations_native">
        <argument
            android:name="initial_tab"
            app:argType="string"
            android:defaultValue="telegram" />
    </fragment>

    <fragment
        android:id="@+id/abrpSettingsFragment"
        android:name="com.overdrive.app.ui.fragment.IntegrationsNativeFragment"
        android:label="@string/nav_page_abrp"
        tools:layout="@layout/fragment_integrations_native">
        <argument
            android:name="initial_tab"
            app:argType="string"
            android:defaultValue="abrp" />
    </fragment>

    <fragment
        android:id="@+id/mqttFragment"
        android:name="com.overdrive.app.ui.fragment.IntegrationsNativeFragment"
        android:label="@string/nav_page_mqtt"
        tools:layout="@layout/fragment_integrations_native">
        <argument
            android:name="initial_tab"
            app:argType="string"
            android:defaultValue="mqtt" />
    </fragment>

    <fragment
        android:id="@+id/bydCloudFragment"
        android:name="com.overdrive.app.ui.fragment.IntegrationsNativeFragment"
        android:label="@string/nav_page_byd_cloud"
        tools:layout="@layout/fragment_integrations_native">
        <argument
            android:name="initial_tab"
            app:argType="string"
            android:defaultValue="byd_cloud" />
    </fragment>

    <!-- RoadSense Native: pure Kotlin/Material 3 hazard sensing, map projection, warnings, blindspot -->
    <fragment
        android:id="@+id/roadSenseFragment"
        android:name="com.overdrive.app.ui.fragment.RoadSenseNativeFragment"
        android:label="@string/rail_roadsense"
        tools:layout="@layout/fragment_roadsense_native" />

    <!-- Network & Hotspot: SIM-data sharing, clients, data limit, proxy.
         Its own top-level destination (not a Daemons entry) because it owns
         the radio and has a live client/stats surface. -->
    <fragment
        android:id="@+id/networkFragment"
        android:name="com.overdrive.app.ui.fragment.NetworkFragment"
        android:label="@string/network_title"
        tools:layout="@layout/fragment_network" />

    <!-- Diagnostics: logs + ADB console + utilities -->
    <fragment
        android:id="@+id/diagnosticsFragment"
        android:name="com.overdrive.app.ui.fragment.DiagnosticsFragment"
        android:label="@string/rail_diagnostics"
        tools:layout="@layout/fragment_diagnostics" />

    <fragment
        android:id="@+id/adbConsoleFragment"
        android:name="com.overdrive.app.ui.fragment.AdbConsoleFragment"
        android:label="@string/diagnostics_section_adb_console"
        tools:layout="@layout/fragment_adb_console" />

    <!-- Settings: native, with sub-rail of sections -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.overdrive.app.ui.fragment.SettingsFragment"
        android:label="@string/rail_settings"
        tools:layout="@layout/fragment_settings">
        <argument
            android:name="settings_subrail_section"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="settings_from_recordings"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <!-- Daemons (used to be its own rail item, now lives under Settings) -->
    <fragment
        android:id="@+id/daemonsFragment"
        android:name="com.overdrive.app.ui.fragment.DaemonsFragment"
        android:label="@string/settings_section_daemons"
        tools:layout="@layout/fragment_daemons" />

    <!-- About — reachable from the portrait Settings hub's About row.
         Hosts the SettingsAboutFragment that shows version, license,
         source link, support links, and the Check for Updates action. -->
    <fragment
        android:id="@+id/settingsAboutFragment"
        android:name="com.overdrive.app.ui.fragment.settings.SettingsAboutFragment"
        android:label="@string/settings_section_about"
        tools:layout="@layout/fragment_settings_about" />

    <!-- Security — PIN lock controls. Reachable from the portrait Settings
         hub's Security card and from the landscape sub-rail Security row. -->
    <fragment
        android:id="@+id/settingsSecurityFragment"
        android:name="com.overdrive.app.ui.fragment.settings.SettingsSecurityFragment"
        android:label="@string/settings_section_security"
        tools:layout="@layout/fragment_settings_security" />

    <!-- Native video player (entered from Recordings) -->
    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.overdrive.app.ui.fragment.VideoPlayerFragment"
        android:label="@string/nav_page_video_player"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="video_path"
            app:argType="string" />
        <argument
            android:name="video_title"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <action
        android:id="@+id/action_global_videoPlayer"
        app:destination="@id/videoPlayerFragment" />
</navigation>
