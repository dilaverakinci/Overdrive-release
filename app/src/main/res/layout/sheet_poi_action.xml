<?xml version="1.0" encoding="utf-8"?>
<!--
  POI action bottom sheet — shown when a charging/fuel marker on the map is
  tapped. Header = type icon + place name + kind; actions = add/remove as a
  trip stop, and "Navigate here" (set as destination). All theme attrs so it
  is correct in day + night.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/sheet_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPoiIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_nav_leading_icon"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_poi_charging" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPoiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Tesla Supercharger" />

            <TextView
                android:id="@+id/tvPoiKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Charging station" />
        </LinearLayout>
    </LinearLayout>

    <!-- EV Station Rich Details Container (Operator, Power, Sockets, Pricing, Address) -->
    <LinearLayout
        android:id="@+id/layoutPoiEvDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Badges Row: Operator, Power, Sockets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPoiOperator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Trugo"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPoiPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="#2500D4AA"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#00D4AA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="180 kW DC"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPoiSockets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="4 Soket"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Tariffs Row: DC Price, AC Price -->
        <LinearLayout
            android:id="@+id/layoutPoiTariffs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvPoiDcPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="DC: 10.99 ₺/kWh"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPoiAcPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="AC: 7.49 ₺/kWh"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Address line -->
        <TextView
            android:id="@+id/tvPoiAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Kadıköy, İstanbul"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPoiStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingVertical="14dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        tools:text="Add stop" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPoiNavigate"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingVertical="14dp"
        android:text="@string/roadsense_map_poi_navigate"
        app:icon="@drawable/ic_directions"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPoiExternalNav"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingVertical="12dp"
        android:text="@string/roadsense_map_poi_external_nav"
        app:icon="@drawable/ic_arrow_outward"
        app:iconGravity="textStart" />

    <!-- Hand the POI to the car's built-in navigation -->
    <TextView
        android:id="@+id/poiCarNavSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp"
        android:text="@string/carnav_section_header"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:alpha="0.7" />

    <LinearLayout
        android:id="@+id/poiCarNavActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPoiCarNavNavigate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:paddingVertical="14dp"
            android:text="@string/carnav_navigate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPoiCarNavSave"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:paddingVertical="14dp"
            android:text="@string/carnav_save_favourite" />
    </LinearLayout>

</LinearLayout>
