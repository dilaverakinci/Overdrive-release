<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardChargingStation"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Operator Badge, Power Pill, Distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Operator Pill -->
            <TextView
                android:id="@+id/tvStationOperator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Trugo"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Power Badge (e.g. 180 kW DC) -->
            <TextView
                android:id="@+id/tvStationPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="#2500D4AA"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="180 kW DC"
                android:textColor="#00D4AA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Sockets count pill -->
            <TextView
                android:id="@+id/tvStationSockets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="4 Soket"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Distance Indicator with Pin Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvStationDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 km"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Middle Section: Station Name & Address -->
        <TextView
            android:id="@+id/tvStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Gersan Çitlekçi İstasyonu"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStationAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Yenimahalle / ANKARA • Fatih Sultan Mehmet Bulvarı No: 12"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Bottom Row: Price Tags and Navigate Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Prices Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStationDcPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_state"
                    android:backgroundTint="#202196F3"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="DC: 14.98 ₺"
                    android:textColor="#2196F3"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStationAcPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_state"
                    android:backgroundTint="#204CAF50"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="AC: 9.95 ₺"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Show on Map Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowStationOnMap"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="@string/charge_stations_show_on_map"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_roadsense_map"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp" />

            <!-- Navigate / Yol Tarifi Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateStation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:minHeight="38dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/charge_stations_navigate"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_location_pin"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
