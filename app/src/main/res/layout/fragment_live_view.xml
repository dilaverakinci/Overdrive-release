<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/liveViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left / Center: Camera Stage -->
    <LinearLayout
        android:id="@+id/cameraStageLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Stage Top Bar: Connection status + Quality menu + Fullscreen -->
        <LinearLayout
            android:id="@+id/cameraTopBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="8dp">

            <!-- Live Status Pill -->
            <LinearLayout
                android:id="@+id/connectionStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/liveStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_dot"
                    android:backgroundTint="@color/status_success" />

                <TextView
                    android:id="@+id/tvLiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CANLI (FRONT)"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Quality Selector Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQualitySelector"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Medium (1M)"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textEnd"
                app:iconSize="16dp" />

            <!-- Fullscreen Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleFullscreen"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Fullscreen"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_fullscreen"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- Video Display Container -->
        <FrameLayout
            android:id="@+id/videoDisplayContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded_border"
            android:clipChildren="true"
            android:clipToOutline="true">

            <!-- Video Frame / JPEG Stream View -->
            <ImageView
                android:id="@+id/ivLiveVideoFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Live Camera Feed"
                android:scaleType="fitCenter" />

            <!-- Idle / Standby Overlay -->
            <LinearLayout
                android:id="@+id/idleStateOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Camera Idle"
                    android:src="@drawable/ic_dashcam_all"
                    app:tint="?attr/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Araç şemasından bir kamera seçin"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvIdleSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kamera seçildiğinde canlı akış görüntülenecektir"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOutline" />

                <ProgressBar
                    android:id="@+id/pbLiveLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Active Camera Badge (Top-Left overlay) -->
            <LinearLayout
                android:id="@+id/cameraLabelOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_state"
                android:backgroundTint="#B3000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvCurrentCameraLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRONT CAMERA"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Deterrent Controls (Bottom-Left overlay) -->
            <LinearLayout
                android:id="@+id/deterrentControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeterrentHorn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="#CCB00020"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="KORNA"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_horn_alert"
                    app:iconSize="18dp"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeterrentFlash"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#CCB26A00"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="FLAŞ"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_lightbulb_alert"
                    app:iconSize="18dp"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Right: Utility Rail (Cameras & Location) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/liveUtilityRail"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Camera Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCameraSelector"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kameralar"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <!-- Car Hotspot Container -->
                    <FrameLayout
                        android:id="@+id/carHotspotContainer"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/ivCarTopView"
                            android:layout_width="160dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:contentDescription="Car Top View"
                            android:scaleType="fitCenter"
                            android:src="@drawable/car_top_view" />

                        <!-- Hotspot FRONT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotFront"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="top|center_horizontal"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="FRONT"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                        <!-- Hotspot DVR (OEM Dashcam) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotDvr"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="38dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="DVR"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                        <!-- Hotspot REAR -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotRear"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="REAR"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                        <!-- Hotspot LEFT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotLeft"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical|start"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="LEFT"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                        <!-- Hotspot RIGHT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotRight"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical|end"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="RIGHT"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                        <!-- Hotspot ALL (Mosaic) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHotspotAll"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|start"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="ALL"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
                    </FrameLayout>

                    <!-- Quick Camera Selector Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCameras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="TÜMÜ (0)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamFront"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ÖN (1)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamRear"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ARKA (3)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamLeft"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOL (4)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamRight"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAĞ (2)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCamDvr"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DVR (6)" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Vehicle Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVehicleLocation"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Araç Konumu"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/gpsFreshnessDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_dot"
                            android:backgroundTint="@color/status_success" />

                        <TextView
                            android:id="@+id/tvGpsFreshness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Güncel"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLocationCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="41.0082° N, 28.9784° E"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvLocationSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hız: 0 km/h · Rakım: 45 m"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOutline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMap"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Haritada Göster"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:icon="@drawable/ic_location_pin"
                        app:iconSize="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
